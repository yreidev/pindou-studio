{
  "name": "pindou-miniapp",
  "version": "0.0.39",
  "private": true,
  "description": "Example示例工坊·拼豆·手作研究室 Taro 微信小程序",
  "scripts": {
    "api:types": "openapi-typescript ../docs/api.yaml -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../docs/api.yaml -o src/api/schema.d.ts --check",
    "check": "npm run api:check && tsc --noEmit && tsc --noEmit -p tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "node node_modules/@tarojs/cli/bin/taro build --type weapp",
    "build:weapp": "node node_modules/@tarojs/cli/bin/taro build --type weapp",
    "dev": "npm run dev:weapp",
    "dev:weapp": "node node_modules/@tarojs/cli/bin/taro build --type weapp --watch",
    "size": "node scripts/package-size.mjs",
    "e2e:shoot": "node tests/e2e/shoot.mjs",
    "e2e:nav": "node tests/e2e/nav.mjs"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tanstack/react-query": "^5.104.1",
    "@tarojs/components": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/router": "^4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "culori": "4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-block-scoping": "^7.29.7",
    "@babel/preset-react": "^7.24.1",
    "@eslint/js": "^10.0.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "@types/culori": "4.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-preset-taro": "4.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsqr": "1.4.0",
    "miniprogram-automator": "0.12.1",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "react-refresh": "^0.14.2",
    "react-test-renderer": "^18.3.1",
    "sass": "^1.75.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^4.5.14",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "miniprogram-automator": {
      "jimp": "0.22.12"
    },
    "rimraf": "^6.1.3"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "@tarojs/binding": false,
    "@tarojs/cli": false,
    "core-js": false,
    "core-js-pure": false,
    "esbuild": false
  }
}
