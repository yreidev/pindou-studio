{
  "name": "pindou-admin",
  "private": true,
  "version": "0.0.39",
  "type": "module",
  "packageManager": "pnpm@11.28.4",
  "scripts": {
    "dev": "vite",
    "routes": "tsr generate",
    "api:types": "openapi-typescript ../docs/api.yaml -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../docs/api.yaml -o src/api/schema.d.ts --check",
    "build": "tsr generate && tsc -b && vite build",
    "check": "pnpm api:check && tsr generate && tsc -b --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "pnpm build && pnpm embed && playwright test",
    "embed": "node scripts/embed.mjs"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.103.0",
    "@douyinfe/semi-ui": "^2.103.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.24.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "openapi-fetch": "0.17.0",
    "partysocket": "1.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
